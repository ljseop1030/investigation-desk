# 기다림 배속. 없으면 1(실제 속도)로 돈다.
# 강윤하의 8~20분을 10으로 나누면 50~120초. 개발 중에만 켠다.
#
# 빌드 시점에 번들로 인라인된다. 배포된 URL의 배속을 바꾸려면 재배포다.
VITE_TEMPO = 1

# 모델 API 키는 여기 두지 않는다. VITE_ 접두사가 붙으면 번들에 박히고,
# 안 붙으면 아무 데서도 안 읽힌다. 어느 쪽도 맞지 않는다.
#
#   로컬   .dev.vars  (wrangler가 읽는다. gitignore 대상)
#   배포   Cloudflare Pages 프로젝트 환경변수(암호화)
#
# .dev.vars 예시
GEMINI_API_KEY = gemini_api_key
GEMINI_MODEL = gemini-2.5-flash