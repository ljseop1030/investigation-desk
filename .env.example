# 로컬 설정 예시. 이 파일을 .env로 복사해서 값을 채운다.
#
# vite와 wrangler가 같은 .env를 읽는다. 역할은 갈려 있다.
#   vite      VITE_ 접두사가 붙은 것만 읽어 번들에 인라인한다
#   wrangler  전부 읽어 함수의 env로 넘긴다
# 그래서 모델 키에 VITE_를 붙이면 안 된다. 붙는 순간 프론트 번들에 박힌다.

# 기다림 배속. 없으면 1(실제 속도)로 돈다.
# 강윤하의 8~20분을 10으로 나누면 50~120초. 개발 중에만 켠다.
#
# 빌드 시점에 번들로 인라인된다. 배포된 URL의 배속을 바꾸려면 재배포다.
VITE_TEMPO=1

# 모델 API 키.
#
#   로컬   이 파일(.env). gitignore 대상이다
#   배포   Cloudflare Pages 프로젝트 환경변수(암호화)
#
# wrangler가 부팅할 때 어느 파일을 읽었는지 직접 찍는다. 버전에 따라 바뀌므로
# 그 줄을 믿는다. 4.131.1 기준으로 `Using secrets defined in .env`.
GEMINI_API_KEY=gemini_api_key

# 모델 id. 기본값은 functions/api/chat.js의 DEFAULT_MODEL에 있고, 덮어쓸
# 때만 적는다. 여기에 기본값을 또 적으면 진실이 둘이 되어 한쪽만 늙는다.
#
# 값 뒤에 아무것도 붙이지 말 것. 세미콜론 하나가 딸려 가서
# `invalid model name: models/…;`로 400을 받은 적이 있다. `=` 주변 공백은
# 파서가 걷어내므로 무해하다.
#
# 무료 티어는 분당 요청 수가 좁다. 3.7-flash 기준 5회이고, 넘기면 429가
# 0.3초 만에 떨어진다(503 혼잡은 4~13초를 끈다). 모델을 바꿔 비교할 때
# 성공률만 보지 말고 RPM도 같이 적어둘 것. P6 「모델 비교」의 축이다.
# GEMINI_MODEL = gemini-3.7-flash